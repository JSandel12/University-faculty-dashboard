# Секрет подписи httpOnly-сессий (обязательно задайте длинную случайную строку в Vercel Environment Variables)
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Опционально для продакшена на Vercel Free Tier (Neon Postgres / Vercel Postgres):
# Подключите Neon Postgres в Vercel Storage — переменная POSTGRES_URL или DATABASE_URL подставится автоматически.
# Локально без POSTGRES_URL приложение автоматически использует локальное файловое хранилище ./data/decanat-db.json.
# POSTGRES_URL=
